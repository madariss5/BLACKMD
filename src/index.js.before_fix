/**
 * BLACKSKY-MD WhatsApp Bot - Main Entry Point
 * Using @whiskeysockets/baileys with enhanced connection persistence
 * Enhanced for 24/7 operation on Heroku
 */

const { connectionManager } = require('./core/connection');
const { commandRegistry } = require('./core/commandRegistry');
const { sessionManager } = require('./core/sessionManager');
const { qrWebServer } = require('./core/qrWebServer');
const logger = require('./utils/logger');
const fs = require('fs');
const path = require('path');
const { ensureDirectoryExists } = require('./utils/fileUtils');
const { addErrorHandlingToAll } = require('./utils/errorHandler');
const { verifyStartupRequirements, displayVerificationReport } = require('./utils/startupVerification');
const { checkMentionsForAfkUsers } = require('./utils/afkMentionHandler');
const { isHeroku, isRailway, isCloudPlatform, initializeAuthFromEnv } = require('./utils/herokuHelper');
const { startHerokuMonitoring, getHealthStatus } = require('./utils/herokuMonitor');
const { setupMessageLogger } = require('./utils/messageLogger');
const { messageDebugger } = require('./debug-messages');
const cron = require('node-cron');
const { execSync } = require('child_process');

// Create required directories
function ensureDirectoriesExist() {
    // Determine the auth directory based on environment
    const authDir = process.env.AUTH_DIR || 'auth_info_baileys';

    const dirs = [
        path.join(process.cwd(), 'data'),
        path.join(process.cwd(), 'data', 'translations'),
        path.join(process.cwd(), 'data', 'reaction_gifs'),
        path.join(process.cwd(), 'logs'),
        path.join(process.cwd(), authDir),
        path.join(process.cwd(), authDir + '_backup')
    ];

    for (const dir of dirs) {
        ensureDirectoryExists(dir);
    }
}

// Set up message handler with error handling
async function setupMessageHandler(sock) {
    // Load and set up the ultra-minimal handler first for guaranteed responses
    const setupUltraMinimalHandler = require('./handlers/ultra-minimal-handler');
    await setupUltraMinimalHandler(sock);
    logger.info('Ultra-minimal handler set up for direct response');

    const commandsDir = path.join(__dirname, 'commands');
    logger.info('Loading commands from:', commandsDir);

    await commandRegistry.loadCommands(commandsDir);
    logger.info(`Loaded ${commandRegistry.getStats().totalCommands} commands in ${commandRegistry.getStats().totalModules} modules`);

    await commandRegistry.initializeModules(sock);

    logger.info('Setting up message handler with error handling...');

    // Configuration option: set to true to process bot's own messages
    const processOwnMessages = true;

    sock.ev.on('messages.upsert', async ({ messages, type }) => {
        if (type !== 'notify') return;

        logger.info(`Received message upsert: type=${type}, messages count=${messages?.length || 0}`);

        for (const message of messages) {
            try {
                // Skip only invalid messages or null messages
                if (!message || !message.key) {
                    logger.debug('Skipping invalid or null message');
                    continue;
                }

                // Enhanced logging for message processing - track with message debugger
                if (message.key.fromMe) {
                    logger.info('📤 RECEIVED MESSAGE FROM BOT - fromMe=true');
                    console.log("📤 RECEIVED MESSAGE FROM BOT - fromMe=true");
                    
                    // Track with message debugger for enhanced visibility
                    try {
                        messageDebugger.trackIncomingMessage(message, 'processing_bot_message');
                    } catch (debugError) {
                        logger.error(`Error in message debugger: ${debugError.message}`);
                    }
                    
                    // Extract text content for improved visibility
                    const botMsgText = message.message?.conversation || 
                                     message.message?.extendedTextMessage?.text || 
                                     'No text content';
                                     
                    console.log("\n=================================================================");
                    console.log(`🤖 BOT MESSAGE CONTENT: "${botMsgText}"`);
                    console.log("=================================================================\n");
                    
                    // Always process bot's messages when flag is enabled
                    if (processOwnMessages) {
                        logger.info('✅ PROCESSING BOT MESSAGE - processOwnMessages=true');
                        console.log("✅ PROCESSING BOT MESSAGE - processOwnMessages=true");
                        // Continue processing the message (don't skip)
                    } else {
                        logger.debug('❌ SKIPPING COMMAND PROCESSING - processOwnMessages=false');
                        console.log("❌ SKIPPING COMMAND PROCESSING - processOwnMessages=false");
                        continue;
                    }
                }

                logger.info(`Message key: ${JSON.stringify(message.key)}`);
                logger.info(`Message type: ${message.message ? Object.keys(message.message).join(', ') : 'unknown'}`);

                // Extract message text
                const msgText = message.message?.conversation || message.message?.extendedTextMessage?.text || '';
                const mentionedJid = message.message?.extendedTextMessage?.contextInfo?.mentionedJid || [];
                logger.info(`Message text: ${msgText}`);
                logger.info(`Mentioned JIDs: ${JSON.stringify(mentionedJid)}`);

                // Extract any mentions/tags from the message
                const mentions = mentionedJid.map(jid => ({
                    tag: '@' + jid.split('@')[0],
                    jid: jid
                }));

                // Don't send initial acknowledgment messages
                // We're now using the ultra-minimal handler for direct responses
                logger.info('Skipping initial response message - using ultra-minimal handler')

                // Check for command prefixes (. or !)
                const supportedPrefixes = ['.', '!', '#'];
                const prefix = supportedPrefixes.find(p => msgText.startsWith(p));

                if (prefix) {
                    logger.info(`Received command with prefix ${prefix}: ${msgText}`);

                    // Track command with message debugger
                    try {
                        messageDebugger.trackIncomingMessage(message, 'command_processing');
                    } catch (debugError) {
                        logger.error(`Error in message debugger tracking command: ${debugError.message}`);
                    }

                    const jid = message.key.remoteJid;
                    const [command, ...args] = msgText.slice(prefix.length).trim().split(' ');

                    logger.info(`Parsed command: ${command}, args: ${JSON.stringify(args)}`);
                    
                    // Log command details prominently
                    console.log("\n=================================================================");
                    console.log(`📋 PROCESSING COMMAND: "${command}" with args: ${JSON.stringify(args)}`);
                    console.log(`📱 FROM: ${message.key.fromMe ? 'BOT ITSELF' : jid}`);
                    console.log(`🔑 MESSAGE ID: ${message.key.id}`);
                    console.log("=================================================================\n");

                    // Skip empty commands
                    if (!command) {
                        logger.info('Empty command received, skipping');
                        await sock.sendMessage(jid, { 
                            text: 'Please provide a command after the prefix.' 
                        });
                        return;
                    }

                    // Skip sending command acknowledgment
                    logger.info('Skipping command acknowledgment - reduced message mode')

                    try {
                        // Special handling for debug command
                        if (command.toLowerCase() === 'debug') {
                            logger.info('Debug command detected, using direct handler');

                            try {
                                // Import debug command directly
                                const debugModule = require('./commands/debug');
                                if (debugModule && debugModule.commands && debugModule.commands.debug) {
                                    logger.info('Executing debug command directly');
                                    await debugModule.commands.debug(sock, message, args);
                                    logger.info('Debug command execution complete');

                                    // Skip regular command handling
                                    return;
                                } else {
                                    logger.warn('Debug module found but handler missing');
                                }
                            } catch (debugError) {
                                logger.error('Error executing debug command directly:', debugError);
                                await sock.sendMessage(jid, { 
                                    text: `Error in direct debug execution: ${debugError.message}` 
                                });
                            }
                        }

                        // Process the command
                        logger.info(`Looking for command handler: ${command}`);

                        // Check if command exists in registry
                        if (commandRegistry.commands.has(command.toLowerCase())) {
                            logger.info(`Command ${command} exists in registry`);
                        } else {
                            logger.warn(`Command ${command} not found in registry`);
                            await sock.sendMessage(jid, { 
                                text: `Command '${command}' not found. Try .help to see available commands.` 
                            });
                            return;
                        }

                        const result = await commandRegistry.handleCommand(sock, jid, command, args.join(' '), mentions);
                        // No need to log the result in full silent mode
                        if (process.env.DEBUG_MODE === 'true') {
                            logger.info(`Command ${command} execution result: ${result ? 'success' : 'not found'}`);
                        }

                        if (!result) {
                            // Only send response for truly unknown commands
                            logger.info(`Sending 'unknown command' message for: ${command}`);
                            await sock.sendMessage(jid, { 
                                text: `Unknown command: ${command}\nUse .help or !help to see available commands.` 
                            });
                        }
                    } catch (error) {
                        logger.error(`Error executing command ${command}:`, error);
                        await sock.sendMessage(jid, { 
                            text: `Error executing command: ${command}\n${error.message}` 
                        });
                    }
                } else {
                    logger.info('Message does not contain a command prefix');
                }
            } catch (msgError) {
                logger.error('Error processing message:', msgError);
            }
        }
    });

    logger.success('Message handler set up successfully');
}

// Initialize language settings for the bot
async function initializeLanguageSettings() {
    try {
        // Load config
        const config = require('./config/config');
        const { languageManager } = require('./utils/language');

        // Set language from config
        const configLanguage = config.bot.language || 'en';
        logger.info(`Initializing bot with language: ${configLanguage}`);

        // Make sure the language is supported, fall back to English if not
        if (languageManager.isLanguageSupported(configLanguage)) {
            const result = languageManager.setLanguage(configLanguage);
            if (result) {
                logger.success(`Successfully set language to: ${configLanguage}`);
            } else {
                logger.warn(`Failed to set language to ${configLanguage}, using default language`);
            }
        } else {
            logger.warn(`Language ${configLanguage} is not supported, falling back to English`);
            languageManager.setLanguage('en');
        }

        // Report available languages
        const availableLanguages = languageManager.getAvailableLanguages();
        logger.info(`Available languages: ${availableLanguages.join(', ')}`);

        // Check for missing translations
        if (configLanguage !== 'en') {
            const stats = languageManager.getTranslationStats();
            if (stats[configLanguage]) {
                logger.info(`${configLanguage} translation completeness: ${stats[configLanguage].percentage}%`);
                if (stats[configLanguage].percentage < 90) {
                    logger.warn(`${configLanguage} translation is incomplete (${stats[configLanguage].percentage}%), some texts may appear in English`);
                }
            }
        }

        return true;
    } catch (error) {
        logger.error('Error initializing language settings:', error);
        return false;
    }
}

// Main function to start the bot
async function startBot() {
    // Define sock at the top level so it's accessible throughout the function
    let sock = null;
    
    try {
        logger.info('Starting BLACKSKY-MD WhatsApp Bot...');

        // Load our simplified message handler
        const setupSimplifiedHandler = require('./simplified-handler');
        logger.info('Loaded simplified message handler');

        // Start HTTP server immediately for better platform detection
        setupHttpServer();
        logger.info('HTTP server started early in the boot process');
        
        // Setup backup cleanup to prevent excessive backup files
        setupBackupCleanup();
        logger.info('Backup cleanup scheduler initialized');

        // Initialize language settings
        await initializeLanguageSettings();

        // Check if running on a cloud platform
        if (isCloudPlatform()) {
            if (isHeroku()) {
                logger.info('Running on Heroku platform');
            } else if (isRailway()) {
                logger.info('Running on Railway platform');
            } else {
                logger.info('Running on a cloud platform');
            }

            // Initialize auth from environment variables if needed
            const initialized = await initializeAuthFromEnv();
            if (initialized) {
                logger.success('Successfully initialized auth from environment variables');
            } else {
                logger.warn('Could not initialize auth from environment variables, will attempt normal connection');
            }
        }

        // Ensure required directories exist
        ensureDirectoriesExist();

        // Run startup verification checks
        logger.info('Performing startup verification checks...');
        const verificationResults = await verifyStartupRequirements();
        displayVerificationReport(verificationResults);

        if (!verificationResults.success) {
            logger.warn('Some startup verification checks failed, but continuing anyway...');
        }

        // Initialize session manager
        await sessionManager.initialize();

        // Connect to WhatsApp 
        let connectionAttempts = 0;
        const maxConnectionAttempts = 3;
        
        while (!sock && connectionAttempts < maxConnectionAttempts) {
            connectionAttempts++;
            logger.info(`Connection attempt ${connectionAttempts}/${maxConnectionAttempts}...`);
            
            try {
                // Attempt connection
                sock = await connectionManager.connect();
                
                if (sock) {
                    logger.info('Successfully connected to WhatsApp');
                    break;
                } else {
                    logger.warn(`Connection attempt ${connectionAttempts} failed`);
                    if (connectionAttempts < maxConnectionAttempts) {
                        logger.info('Waiting 5 seconds before next attempt...');
                        await new Promise(resolve => setTimeout(resolve, 5000));
                    }
                }
            } catch (connError) {
                logger.error(`Connection error on attempt ${connectionAttempts}:`, connError);
                if (connectionAttempts < maxConnectionAttempts) {
                    logger.info('Waiting 5 seconds before next attempt...');
                    await new Promise(resolve => setTimeout(resolve, 5000));
                }
            }
        }
        
        if (!sock) {
            logger.error(`Failed to create WhatsApp connection after ${maxConnectionAttempts} attempts`);
            return;
        }
        
        // Set up message handler immediately
        logger.info('Setting up message handler...');
        await setupMessageHandler(sock);
        
        // Set up enhanced message logging
        const { setupMessageLogger } = require('./utils/messageLogger');
        setupMessageLogger(sock);
        logger.info('Enhanced message logging activated');
        
        // Set up message debugger to diagnose message processing issues
        try {
            const { setupMessageDebugger } = require('./debug-messages');
            setupMessageDebugger(sock);
            logger.info('Message debugger activated to track all messages');
        } catch (debuggerError) {
            logger.error(`Error setting up message debugger: ${debuggerError.message}`);
            logger.info('Continuing without message debugger');
        }
        
        // Set up connection event handler for QR code and connection status
        connectionManager.onConnectionUpdate(async (update) => {
            const { connection, qr, lastDisconnect } = update;

            if (qr) {
                logger.info('QR Code received, scan it using your WhatsApp app');
                const qrcodeTerminal = require('qrcode-terminal');
                qrcodeTerminal.generate(qr, {small: true});
            }

            if (connection === 'open') {
                logger.success('Connected to WhatsApp');

                // Create a backup of the session
                await sessionManager.backupSession();

                setTimeout(async () => {
                    try {
                        if (!sock?.user?.id) {
                            logger.warn('No valid user ID found, retrying startup message...');
                            return;
                        }

                        const botNumber = sock.user.id.split(':')[0];
                        const botJid = `${botNumber}@s.whatsapp.net`;
                        logger.info(`Sending startup message to ${botJid}`);

                        const timestamp = new Date().toLocaleString();
                        await sock.sendMessage(botJid, {
                            text: `🟢 *BLACKSKY-MD Bot Online*\n\n✅ Bot successfully connected at ${timestamp}\n\n_Ready to process commands_`,
                            contextInfo: {
                                externalAdReply: {
                                    title: "BLACKSKY-MD",
                                    body: "Bot is online",
                                    previewType: "PHOTO",
                                    showAdAttribution: true
                                }
                            }
                        });
                        logger.success('Startup message sent successfully');
                    } catch (error) {
                        logger.error('Failed to send startup message:', error);
                        // Retry after 10 seconds with a simpler message
                        setTimeout(async () => {
                            try {
                                const botNumber = sock.user.id.split(':')[0];
                                await sock.sendMessage(`${botNumber}@s.whatsapp.net`, {
                                    text: '✅ Bot is online and ready'
                                });
                                logger.success('Retry startup message sent successfully');
                            } catch (retryError) {
                                logger.error('All startup message attempts failed:', retryError);
                            }
                        }, 10000);
                    }
                }, 3000);
            }
        });
    } catch (startupError) {
        logger.error('Error during bot startup:', startupError);
        // Continue execution to allow clean up and prevent hard crash
    }

    // Set up automatic reconnection
    connectionManager.onConnectionUpdate((update) => {
        const { connection, lastDisconnect } = update;

        if (connection === 'close') {
            // Schedule reconnection if needed
            setTimeout(async () => {
                const status = connectionManager.getStatus();
                if (!status.isConnected && !status.isConnecting) {
                    logger.info('Attempting reconnection...');
                    await connectionManager.connect();
                }
            }, 5000); // Wait 5 seconds before attempting reconnect
        }
    });

    // Log connection status periodically
    setInterval(() => {
        const status = connectionManager.getStatus();
        if (status.isConnected) {
            logger.debug('Connection status: Connected');
        } else if (status.isConnecting) {
            logger.debug('Connection status: Connecting...');
        } else {
            logger.debug('Connection status: Disconnected');
        }
    }, 60000); // Check every minute

    // Set up graceful shutdown
    setupGracefulShutdown();

    // Set up connection diagnostics logging
    setupConnectionDiagnostics();

    // Start platform monitoring if on a cloud platform
    if (isCloudPlatform()) {
        if (isHeroku()) {
            startHerokuMonitoring(connectionManager);
        } else if (isRailway()) {
            // Railway has built-in monitoring, but we'll log platform info
            logger.info('Railway deployment detected - using built-in monitoring');
            // Log basic system information for Railway
            const os = require('os');
            logger.info(`System Information: ${os.platform()} ${os.arch()} with ${Math.round(os.totalmem() / (1024 * 1024))}MB RAM`);
            logger.info(`Railway Service ID: ${process.env.RAILWAY_SERVICE_ID || 'Not available'}`);
        }
    }
}

/**
 * Set up periodic connection diagnostics logging
 */
function setupConnectionDiagnostics() {
    // Log comprehensive connection diagnostics every 15 minutes
    setInterval(() => {
        const diagnostics = connectionManager.getDiagnostics();
        logger.info('Connection Diagnostics Report:', JSON.stringify(diagnostics, null, 2));

        // If there are issues, log more details
        if (diagnostics.connectionHealth < 70) {
            logger.warn('Connection health is suboptimal:', diagnostics.connectionHealth);

            if (diagnostics.consecutiveFailedPings > 0) {
                logger.warn(`Failed heartbeat pings: ${diagnostics.consecutiveFailedPings}`);
            }

            if (diagnostics.reconnectFailure > 0) {
                logger.warn(`Failed reconnection attempts: ${diagnostics.reconnectFailure}`);
            }
        }
    }, 15 * 60 * 1000); // Every 15 minutes
}

// Handle graceful shutdown
function setupGracefulShutdown() {
    const shutdown = async (signal) => {
        logger.info(`Received ${signal}, shutting down gracefully...`);

        // Stop the session manager backups
        sessionManager.stopScheduledBackups();

        // Create a final backup before exit
        await sessionManager.backupSession();

        // Disconnect from WhatsApp if connected
        await connectionManager.disconnect();

        logger.info('Shutdown complete, exiting now');
        process.exit(0);
    };

    // Handle termination signals
    process.on('SIGINT', () => shutdown('SIGINT'));
    process.on('SIGTERM', () => shutdown('SIGTERM'));
}

/**
 * Sets up automated backup cleanup to prevent excessive backups
 */
function setupBackupCleanup() {
    logger.info('Setting up aggressive backup cleanup (runs hourly)');
    
    try {
        // Schedule backup cleanup to run every hour
        cron.schedule('0 * * * *', () => {
            try {
                logger.info('Running hourly backup cleanup...');
                
                // Run the cleanup script
                const output = execSync('node auto-cleanup-backups.js').toString();
                logger.info('Backup cleanup completed successfully');
                
                if (process.env.DEBUG_MODE === 'true') {
                    logger.debug(output);
                }
            } catch (error) {
                logger.error('Error during hourly backup cleanup:', error);
            }
        });
        
        // Also run the cleanup immediately
        setTimeout(() => {
            try {
                logger.info('Running initial backup cleanup...');
                const output = execSync('node auto-cleanup-backups.js').toString();
                logger.info('Initial backup cleanup completed');
            } catch (error) {
                logger.error('Error during initial backup cleanup:', error);
            }
        }, 60 * 1000); // Run 1 minute after startup
        
        logger.success('Backup cleanup scheduler initialized');
    } catch (error) {
        logger.error('Failed to set up backup cleanup:', error);
    }
}
