# BLACKSKY-MD WhatsApp Bot - Heroku Environment Variables Example
# Copy these variables to your Heroku app's Config Vars

# === REQUIRED SETTINGS ===

# Platform identifier (must be "heroku" for Heroku deployment)
PLATFORM=local

# Environment mode (use "production" for Heroku)
NODE_ENV=development

# WhatsApp Bot Owner's number (without the + sign)
# Use your full number without any symbols (no +, spaces, or dashes)
# Example: 12025550199 for US number +1 (202) 555-0199
OWNER_NUMBER=4915561048015

# Bot command prefix
BOT_PREFIX=.

# Bot name
BOT_NAME=BLACKSKY-MD

# Authentication directory (default is "auth_info_baileys")
AUTH_DIR=auth_info_baileys

# WhatsApp session credentials (obtained using the .getcreds command)
# This will be a long base64 encoded string - replace with your actual credentials
# WhatsApp session credentials (automatically loaded from auth_info_baileys/creds.json)
CREDS_PATH=auth_info_baileys/creds.json

# === OPTIONAL SETTINGS ===

# Debug logs (optional, set to "true" for more detailed logs)
DEBUG_LOGS=true

# Language (optional, default is English)
BOT_LANG=en

# === API KEYS (Optional) ===
# Only add the API keys for features you want to use

# Weather commands
OPENWEATHERMAP_API_KEY=

# Google services
GOOGLE_API_KEY=

# YouTube commands
YOUTUBE_API_KEY=

# Spotify commands
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# News API
NEWS_API_KEY=

# OpenAI features
OPENAI_API_KEY=

# Background removal
REMOVEBG_API_KEY=

# Scientific calculations
WOLFRAM_APP_ID=

# Movie and TV info
TMDB_API_KEY=

# Translation services
DEEPL_API_KEY=

# SMS functionality
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === BOT BEHAVIOR SETTINGS ===
# Force the bot to act as an admin for testing
FORCE_ADMIN_MODE=true
# Track if command was initiated by owner
OWNER_INITIATED=true
# WhatsApp Bot Owner number (no spaces or special chars)
OWNER_NUMBER=4915561048015
# Force group commands to be recognized as owner (set to 'true' for testing)
FORCE_GROUP_OWNER_RECOGNITION=true

# === HEROKU-SPECIFIC SETTINGS ===
# These are automatically set by Heroku

# Heroku app name
HEROKU_APP_NAME=

# Port will be automatically assigned by Heroku, so this is not needed
PORT=5000
YOUTUBE_DL_SKIP_DOWNLOAD=1
YOUTUBE_DL_SKIP_PYTHON_CHECK=1
